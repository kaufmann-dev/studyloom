{
	"name": "studyloom",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsup src/server/runtime.ts --format esm --out-dir build/runtime --external ./handler.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run --project server",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"start": "node server.mjs",
		"test:components": "vitest run --project client",
		"tools:check": "node scripts/check-tools.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"@vitest/browser-playwright": "^5.1.0",
		"bits-ui": "^2.20.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"formsnap": "^2.1.0",
		"globals": "^17.14.0",
		"layerchart": "^2.9.2",
		"paneforge": "^1.0.2",
		"playwright": "^1.64.1",
		"postgres": "^4.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"tsup": "^9.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.322",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.68.0",
		"dompurify": "^3.4.17",
		"katex": "^0.19.1",
		"marked": "^18.1.3",
		"marked-katex-extension": "^5.1.13",
		"mermaid": "^12.3.0",
		"mode-watcher": "^1.1.0",
		"openid-client": "6.8.9",
		"sveltekit-superforms": "3.1.0",
		"ws": "^8.22.1",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": "26.x"
	},
	"packageManager": "pnpm@12.16.1",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
