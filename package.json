{
	"name": "studyloom",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsup src/server/runtime.ts src/server/mcp.ts --format esm --out-dir build/runtime --external ./handler.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run --project server",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"start": "node server.mjs",
		"test:components": "vitest run --project client",
		"tools:check": "node scripts/check-tools.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.0",
		"@types/ws": "^8.18.2",
		"@vitest/browser-playwright": "^5.0.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"globals": "^17.12.0",
		"layerchart": "^2.5.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.63.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsup": "^8.5.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.1",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@modelcontextprotocol/sdk": "1.31.0",
		"dompurify": "^3.4.16",
		"marked": "^18.0.14",
		"mode-watcher": "^1.1.0",
		"openid-client": "6.8.8",
		"sveltekit-superforms": "3.0.0-next.1",
		"ws": "^8.22.0",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@11.18.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
